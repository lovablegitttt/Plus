# ==============================================================================
# PAYPLUS ENVIRONMENT CONFIGURATION
# Copy this file to .env or add these variables directly in Vercel / Cloud Run
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TELEGRAM BOT & ADMIN CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN_FROM_BOTFATHER"

# Admin Telegram username (without @) - Only this user will have admin access
TELEGRAM_ADMIN_USERNAME="paulallen"

# Admin Telegram numerical User ID (Get your ID by messaging @userinfobot on Telegram)
TELEGRAM_ADMIN_ID="1979711369"

# Custom Secret Key for Admin API Authorization (Header: x-admin-key)
ADMIN_SECRET_KEY="paulallen-admin"

# Private VIP / Premium Channel Invite Link (Sent to users after watching 10 ads)
TELEGRAM_PREMIUM_CHANNEL_LINK="https://t.me/+PayPlusVIPExclusive"

# Private VIP Channel ID (e.g. -1001234567890) for automated chat join approval
TELEGRAM_PREMIUM_CHANNEL_ID=""

# Application Base URL (Set to your Vercel URL in production: e.g. https://your-app.vercel.app)
APP_URL="https://your-app.vercel.app"

# ------------------------------------------------------------------------------
# 2. MONETAG ADVERTISING CONFIGURATION
# ------------------------------------------------------------------------------
# Monetag Zone ID for Rewarded In-App Ads
MONETAG_ZONE_ID="11679016"

# Monetag In-App Script SDK URL
MONETAG_SCRIPT_URL="//libtl.com/sdk.js"

# Monetag Custom SDK Function Name
MONETAG_CUSTOM_CODE="show_11679016"

# Optional: Monetag Direct Link (Popunder / Smartlink)
MONETAG_DIRECT_LINK=""

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (FIRESTORE & SUPABASE)
# ------------------------------------------------------------------------------
# Firebase Firestore is automatically configured via firebase-applet-config.json

# Optional: Supabase PostgreSQL Database for secondary backup
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# 4. AI & PLATFORM CONFIGURATION
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Optional for AI Studio assistant features
GEMINI_API_KEY=""
